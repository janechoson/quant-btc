{
  "name": "btc-pattern-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "build": "vue-tsc --noEmit && tsc -p server/tsconfig.json && vite build --config vite.config.ts",
    "start": "node dist/server/index.js",
    "migrate:json": "tsx server/src/migrate-json.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "lightweight-charts": "^4.2.1",
    "pinia": "^2.3.0",
    "sql.js": "^1.13.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.13.10",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
